# ElevenLabs TTS Configuration
# REQUIRED: Get your API key from https://elevenlabs.io
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# Server Configuration
# Host to bind the server to (0.0.0.0 = all interfaces)
HOST=0.0.0.0

# Port to run the server on
PORT=8000

# Optional API Authentication
# If set, clients must provide this key in the X-API-Key header
API_KEY=

# Audio File Configuration
# Directory where generated TTS audio files will be stored
AUDIO_DIR=static/audio

# Background Task Intervals (in minutes)
# How often to refresh the Sonos speaker discovery cache
SPEAKER_DISCOVERY_INTERVAL_MINUTES=5

# Delete audio files older than this many minutes
AUDIO_CLEANUP_MAX_AGE_MINUTES=60
